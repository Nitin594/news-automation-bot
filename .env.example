# ==============================================================================
# Daily Tech Brief - Environment Configuration (.env)
# Copy this file to .env and configure your values.
# NEVER commit your real .env file or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Telegram Delivery Settings
# Create a bot via @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN.
# Get your TELEGRAM_CHAT_ID by messaging @userinfobot or checking bot updates.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# Email Delivery Settings (SMTP)
# Default is configured for Gmail SMTP (requires an App Password with 2FA enabled).
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SENDER=
EMAIL_RECIPIENT=

# ------------------------------------------------------------------------------
# Timezone & Scheduling
# Default is India Standard Time (Asia/Kolkata, UTC+05:30).
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# Digest & Filtering Configuration
# ------------------------------------------------------------------------------
DIGEST_LIMIT=10
LOOKBACK_HOURS=24
FALLBACK_LOOKBACK_HOURS=48
MAX_ARTICLES_PER_SOURCE=2
ENABLE_OPPORTUNITIES=true

# ------------------------------------------------------------------------------
# Storage & Logging
# ------------------------------------------------------------------------------
DATABASE_PATH=data/daily_tech_brief.db
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Optional AI Summarization
# Supported providers: gemini, openai, anthropic, or groq.
# Set ENABLE_LLM_SUMMARIES=false to run in 100% free mode with zero external AI cost.
# ------------------------------------------------------------------------------
ENABLE_LLM_SUMMARIES=false
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
